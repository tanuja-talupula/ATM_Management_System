        "import json\n",
        "\n",
        "\n",
        "class ATM:\n",
        "    def __init__(self, filename):\n",
        "        self.filename = filename\n",
        "        self.users = self.load_users()\n",
        "\n",
        "    # ---------------- FILE HANDLING ----------------\n",
        "\n",
        "    def load_users(self):\n",
        "        \"\"\"Load user data from JSON file.\"\"\"\n",
        "        try:\n",
        "            with open(self.filename, \"r\") as file:\n",
        "                users = json.load(file)\n",
        "\n",
        "            print(f\"\\nSuccessfully loaded: {self.filename}\")\n",
        "            return users\n",
        "\n",
        "        except FileNotFoundError:\n",
        "            print(\"\\nError: File not found.\")\n",
        "            return {}\n",
        "\n",
        "        except json.JSONDecodeError:\n",
        "            print(\"\\nError: Invalid JSON file.\")\n",
        "            return {}\n",
        "\n",
        "    def save_users(self):\n",
        "        \"\"\"Save user data to JSON file.\"\"\"\n",
        "        try:\n",
        "            with open(self.filename, \"w\") as file:\n",
        "                json.dump(self.users, file, indent=4)\n",
        "\n",
        "            print(\"User data saved successfully.\")\n",
        "\n",
        "        except Exception as e:\n",
        "            print(f\"Error saving user data: {e}\")\n",
        "\n",
        "    # ---------------- AUTHENTICATION ----------------\n",
        "\n",
        "    def login(self):\n",
        "        \"\"\"Authenticate user using account number and PIN.\"\"\"\n",
        "\n",
        "        print(\"\\n========== ATM LOGIN ==========\")\n",
        "\n",
        "        account_number = input(\"Enter Account Number: \").strip()\n",
        "        pin = input(\"Enter PIN: \").strip()\n",
        "\n",
        "        if account_number in self.users:\n",
        "            if self.users[account_number][\"pin\"] == pin:\n",
        "                print(\"\\nLogin successful!\")\n",
        "                print(\"Welcome,\", self.users[account_number][\"name\"])\n",
        "                return account_number\n",
        "\n",
        "        print(\"\\nInvalid account number or PIN.\")\n",
        "        return None\n",
        "\n",
        "    # ---------------- BALANCE ----------------\n",
        "\n",
        "    def check_balance(self, account_number):\n",
        "        \"\"\"Display current account balance.\"\"\"\n",
        "\n",
        "        balance = self.users[account_number][\"balance\"]\n",
        "\n",
        "        print(\"\\n---------- BALANCE ----------\")\n",
        "        print(f\"Available Balance: ₹{balance:.2f}\")\n",
        "\n",
        "    # ---------------- DEPOSIT ----------------\n",
        "\n",
        "    def deposit(self, account_number):\n",
        "        \"\"\"Deposit money into account.\"\"\"\n",
        "\n",
        "        print(\"\\n---------- CASH DEPOSIT ----------\")\n",
        "\n",
        "        try:\n",
        "            amount = float(input(\"Enter amount to deposit: ₹\"))\n",
        "\n",
        "            if amount <= 0:\n",
        "                print(\"Amount must be greater than zero.\")\n",
        "                return\n",
        "\n",
        "            self.users[account_number][\"balance\"] += amount\n",
        "            self.save_users()\n",
        "\n",
        "            print(f\"₹{amount:.2f} deposited successfully.\")\n",
        "            print(\n",
        "                f\"New Balance: \"\n",
        "                f\"₹{self.users[account_number]['balance']:.2f}\"\n",
        "            )\n",
        "\n",
        "        except ValueError:\n",
        "            print(\"Invalid amount. Please enter a number.\")\n",
        "\n",
        "    # ---------------- WITHDRAW ----------------\n",
        "\n",
        "    def withdraw(self, account_number):\n",
        "        \"\"\"Withdraw money from account.\"\"\"\n",
        "\n",
        "        print(\"\\n---------- CASH WITHDRAWAL ----------\")\n",
        "\n",
        "        try:\n",
        "            amount = float(input(\"Enter amount to withdraw: ₹\"))\n",
        "\n",
        "            if amount <= 0:\n",
        "                print(\"Amount must be greater than zero.\")\n",
        "                return\n",
        "\n",
        "            balance = self.users[account_number][\"balance\"]\n",
        "\n",
        "            if amount > balance:\n",
        "                print(\"Insufficient balance.\")\n",
        "                return\n",
        "\n",
        "            self.users[account_number][\"balance\"] -= amount\n",
        "            self.save_users()\n",
        "\n",
        "            print(f\"₹{amount:.2f} withdrawn successfully.\")\n",
        "            print(\n",
        "                f\"Remaining Balance: \"\n",
        "                f\"₹{self.users[account_number]['balance']:.2f}\"\n",
        "            )\n",
        "\n",
        "        except ValueError:\n",
        "            print(\"Invalid amount. Please enter a number.\")\n",
        "\n",
        "    # ---------------- PIN CHANGE ----------------\n",
        "\n",
        "    def change_pin(self, account_number):\n",
        "        \"\"\"Change user's PIN.\"\"\"\n",
        "\n",
        "        print(\"\\n---------- PIN CHANGE ----------\")\n",
        "\n",
        "        old_pin = input(\"Enter current PIN: \").strip()\n",
        "\n",
        "        if old_pin != self.users[account_number][\"pin\"]:\n",
        "            print(\"Incorrect current PIN.\")\n",
        "            return\n",
        "\n",
        "        new_pin = input(\"Enter new 4-digit PIN: \").strip()\n",
        "        confirm_pin = input(\"Confirm new PIN: \").strip()\n",
        "\n",
        "        if not new_pin.isdigit() or len(new_pin) != 4:\n",
        "            print(\"PIN must contain exactly 4 digits.\")\n",
        "            return\n",
        "\n",
        "        if new_pin != confirm_pin:\n",
        "            print(\"PINs do not match.\")\n",
        "            return\n",
        "\n",
        "        self.users[account_number][\"pin\"] = new_pin\n",
        "        self.save_users()\n",
        "\n",
        "        print(\"PIN changed successfully.\")\n",
        "\n",
        "    # ---------------- MENU ----------------\n",
        "\n",
        "    def menu(self, account_number):\n",
        "\n",
        "        while True:\n",
        "\n",
        "            print(\"\\n================================\")\n",
        "            print(\"       ATM MANAGEMENT SYSTEM\")\n",
        "            print(\"================================\")\n",
        "            print(\"1. Balance Inquiry\")\n",
        "            print(\"2. Cash Deposit\")\n",
        "            print(\"3. Cash Withdrawal\")\n",
        "            print(\"4. Change PIN\")\n",
        "            print(\"5. Logout\")\n",
        "            print(\"================================\")\n",
        "\n",
        "            choice = input(\"Enter your choice (1-5): \").strip()\n",
        "\n",
        "            if choice == \"1\":\n",
        "                self.check_balance(account_number)\n",
        "\n",
        "            elif choice == \"2\":\n",
        "                self.deposit(account_number)\n",
        "\n",
        "            elif choice == \"3\":\n",
        "                self.withdraw(account_number)\n",
        "\n",
        "            elif choice == \"4\":\n",
        "                self.change_pin(account_number)\n",
        "\n",
        "            elif choice == \"5\":\n",
        "                print(\"\\nYou have been logged out successfully.\")\n",
        "                break\n",
        "\n",
        "            else:\n",
        "                print(\"Invalid choice. Please select 1-5.\")\n",
        "\n",
        "# ---------------- MAIN PROGRAM ----------------\n",
        "\n",
        "def main():\n",
        "\n",
        "  filename = input("Enter the JSON file name: ").strip()\n",
        "\n",
        "  atm = ATM(filename)\n",
        "\n",
        "  print(\"\\n********************************\")\n",
        "  print(\"    WELCOME TO PYTHON ATM\")\n",
        "  print(\"********************************\")\n",
        "\n",
        "  account_number = atm.login()\n",
        "\n",
        "  if account_number:\n",
        "      atm.menu(account_number)\n",
        "\n",
        "  print(\"\\nThank you for using the ATM.\")\n",
        "  print(\"Have a nice day!\")\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()\n",
        ""
      ]
    }
  ]
